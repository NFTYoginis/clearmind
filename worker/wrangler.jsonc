{
  // ClearMind: The Other Side — the no-account hosted thinking companion.
  // The Worker is a thin, stateful-per-request proxy: it injects the cached system
  // prompt + the server-side API key, enforces budget/abuse guards, and streams the
  // Anthropic response back to the browser. The browser holds the transcript; the
  // server holds the secret.
  "name": "clearmind",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",

  // Static no-account chat UI lives in ./public and is served by the assets binding.
  // Non-asset paths (e.g. /api/chat) fall through to the Worker's fetch handler.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // Model is a var so the operator can flip Sonnet 4.6 (budget) <-> Opus 4.8 (max quality)
  // without touching code. See README "Cost & model".
  "vars": {
    "CLEARMIND_MODEL": "claude-sonnet-4-6"
  },

  // Per-IP abuse/budget guard. Uses the native [[ratelimits]] binding (NOT
  // [[unsafe.bindings]]); namespace_id is a numeric string unique within the account;
  // period must be 10 or 60. 30 requests / 60s comfortably covers a real human
  // conversation while capping runaway/scripted traffic. Cost-free to test.
  "ratelimits": [
    {
      "name": "CHAT_RL",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    }
  ],

  "observability": { "enabled": true }

  // SECRET (never in this file, never client-exposed) — set before deploy:
  //   wrangler secret put ANTHROPIC_API_KEY
}
